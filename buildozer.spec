[app]
title = Corange Jogos
package.name = corangejogos
package.domain = com.corange.jogos
source.dir = .
source.include_exts = py,png,jpg,wav,mp3,json,kv,atlas
version = 1.0
requirements = python3,kivy
orientation = portrait
fullscreen = 0
android.permissions = INTERNET
android.api = 33
android.minapi = 21
android.ndk = 25b
android.archs = arm64-v8a
android.accept_sdk_license = True
p4a.branch = stable

[buildozer]
log_level = 2
warn_on_root = 1
