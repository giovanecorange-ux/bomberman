[app]
title = Bomberman Corange
package.name = bombermancorange
package.domain = org.corange.bomberman
source.dir = .
source.include_exts = py,png,jpg,kv,atlas,mp3,wav,txt
version = 1.0
requirements = python3,pygame
orientation = landscape
fullscreen = 0
